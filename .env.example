# Shared across services (each service's own .env in dev, or a k8s Secret in prod)
MONGODB_URI=mongodb://localhost:27017/nagar_seva
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# --- services/core-service/.env ---
CORE_SERVICE_PORT=4001
NOTIFICATION_INTERNAL_URL=http://localhost:4002/internal
# SMS provider: "console" logs OTPs to the server terminal for local dev.
# Switch to a real provider (e.g. "msg91") before production and add its credentials.
SMS_PROVIDER=console

# --- services/notification-service/.env ---
NOTIFICATION_SERVICE_PORT=4002

# --- services/media-service/.env ---
MEDIA_SERVICE_PORT=4003
STORAGE_PROVIDER=local

# --- services/api-gateway/.env ---
GATEWAY_PORT=4000
CORE_SERVICE_GRAPHQL_URL=http://localhost:4001/graphql
NOTIFICATION_SERVICE_GRAPHQL_URL=http://localhost:4002/graphql

# --- client/.env ---
VITE_GRAPHQL_URL=http://localhost:4000/graphql
VITE_MEDIA_URL=http://localhost:4003
# Report downloads (PDF/Excel) are plain REST on core-service, called directly like media-service.
VITE_CORE_REST_URL=http://localhost:4001
